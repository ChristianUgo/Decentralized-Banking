{
  "name": "decentralized-banking",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "workspaces": [
    "frontend"
  ],
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter frontend dev",
    "build": "pnpm --filter frontend build",
    "lint": "pnpm --filter frontend lint",
    "test": "pnpm test:contracts && pnpm --filter frontend test",
    "test:contracts": "hardhat test",
    "compile": "hardhat compile",
    "deploy:local": "hardhat run scripts/deploy.js",
    "export:artifacts": "node scripts/export-frontend-artifacts.js",
    "check": "pnpm lint && pnpm test && pnpm build && pnpm compile"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "4.0.15",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "3.0.11",
    "@nomicfoundation/hardhat-mocha": "3.1.0",
    "chai": "6.2.2",
    "ethers": "6.17.0",
    "hardhat": "3.13.0",
    "mocha": "11.8.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1"
  }
}
